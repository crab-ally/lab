<mujoco model="turtlebot_patrol">
    <compiler angle="degree" coordinate="local" inertiafromgeom="false"/>
    <option integrator="implicitfast" timestep="0.005" gravity="0 0 -9.81"/> <!-- 200Hz 물리 -->

    <default>
        <joint damping="0.01" armature="0.001"/>
        <geom friction="1.0 0.005 0.0001" condim="3" contype="1" conaffinity="1"/>
    </default>

    <worldbody>
        <!-- base_link 높이: 바퀴 반경 0.033m에 맞추어 z=0.033에 배치 -->
        <body name="base_link" pos="-4 -4 0.033" quat="0.707107 0 0 0.707107">
            <freejoint name="root"/>
            
            <!-- 
                [핵심 수정: 무게중심 조정]
                - mass: 로봇 전체 질량의 대부분(약 0.85kg)을 base_link에 집약
                - pos: 바퀴 중심(0,0)보다 약간 뒤(-0.025m) 및 낮은 위치(0.02m)로 설정
                -> acceleration/deceleration 시 쏠림 최소화 및 3점 지지 안정성 확보
            -->
            <inertial pos="-0.025 0 0.020" mass="0.85"
                      diaginertia="0.0022 0.0022 0.0035"/>

            <!-- 1층: 하단 플레이트 (z = 0.005) -->
            <geom name="base_plate_lower" type="box"
                  size="0.069 0.075 0.0025" pos="0 0 0.005"
                  rgba="0.15 0.15 0.15 1"/>

            <!-- 2층: 중단 플레이트 (z = 0.075) -->
            <geom name="base_plate_middle" type="box"
                  size="0.069 0.075 0.0025" pos="0 0 0.075"
                  rgba="0.15 0.15 0.15 1"/>

            <!-- 3층: 상단 플레이트 (z = 0.135) -->
            <geom name="base_plate_upper" type="box"
                  size="0.069 0.075 0.0025" pos="0 0 0.135"
                  rgba="0.15 0.15 0.15 1"/>

            <!-- 플레이트 간 지지 기둥 (1층 ~ 3층 연결) -->
            <geom name="pillar_fl" type="cylinder"
                  size="0.004 0.065" pos="0.05 0.055 0.070"
                  rgba="0.7 0.7 0.7 1" contype="0" conaffinity="0"/>
            <geom name="pillar_fr" type="cylinder"
                  size="0.004 0.065" pos="0.05 -0.055 0.070"
                  rgba="0.7 0.7 0.7 1" contype="0" conaffinity="0"/>
            <geom name="pillar_rl" type="cylinder"
                  size="0.004 0.065" pos="-0.05 0.055 0.070"
                  rgba="0.7 0.7 0.7 1" contype="0" conaffinity="0"/>
            <geom name="pillar_rr" type="cylinder"
                  size="0.004 0.065" pos="-0.05 -0.055 0.070"
                  rgba="0.7 0.7 0.7 1" contype="0" conaffinity="0"/>

            <!-- 왼쪽 구동 바퀴 -->
            <body name="wheel_left" pos="0 0.08 0" quat="0.707107 0.707107 0 0">
                <joint name="drive_left" type="hinge" axis="0 0 -1"
                       damping="0.005" frictionloss="0.01"/>
                <inertial pos="0 0 0" mass="0.04"
                          diaginertia="0.00002 0.00002 0.00003"/>
                <geom name="wheel_left_geom" type="cylinder"
                      size="0.033 0.009" rgba="0.05 0.05 0.05 1"
                      friction="1.2 0.005 0.0001"/>
            </body>

            <!-- 오른쪽 구동 바퀴 -->
            <body name="wheel_right" pos="0 -0.08 0" quat="0.707107 0.707107 0 0">
                <joint name="drive_right" type="hinge" axis="0 0 -1"
                       damping="0.005" frictionloss="0.01"/>
                <inertial pos="0 0 0" mass="0.04"
                          diaginertia="0.00002 0.00002 0.00003"/>
                <geom name="wheel_right_geom" type="cylinder"
                      size="0.033 0.009" rgba="0.05 0.05 0.05 1"
                      friction="1.2 0.005 0.0001"/>
            </body>

            <!-- 
                [핵심 수정: 후방 볼 캐스터]
                - pos: z = -0.023m (반경 0.010m 포함 시 ground level z=-0.033m에 정확히 오차 없이 접지)
                - friction: 슬라이딩 마찰을 극소화(0.005)하여 주행 저항 및 기울어짐 회전력 차단
            -->
            <body name="caster_ball" pos="-0.055 0 -0.023">
                <geom name="caster_geom" type="sphere" size="0.010"
                      rgba="0.6 0.6 0.6 1" friction="0.005 0.001 0.0001"
                      mass="0.01"/>
            </body>

            <!-- 센서 타워 및 센서류 -->
            <body name="sensor_tower" pos="0 0 0.1375">
                <!-- LiDAR 마운트 -->
                <geom name="tower_post" type="cylinder"
                      size="0.008 0.015" pos="0 0 0.015"
                      rgba="0.3 0.3 0.3 1" contype="0" conaffinity="0" mass="0.01"/>

                <!-- LDS-01 LiDAR 센서 -->
                <body name="lidar_body" pos="0 0 0.030">
                    <inertial pos="0 0 0" mass="0.08"
                              diaginertia="0.00003 0.00003 0.00002"/>
                    <geom name="lidar_geom" type="cylinder"
                          size="0.035 0.012" rgba="0.1 0.1 0.1 1"
                          contype="0" conaffinity="0"/>
                    <replicate count="360" sep="-" offset="0 0 0" euler="0 0 1">
                        <site name="lidar_site" pos="0.036 0 0" euler="0 90 0" size="0.002"/>
                    </replicate>
                </body>

                <!-- 카메라 후방 지지대 -->
                <geom name="camera_support"
                      type="cylinder"
                      size="0.006 0.10"
                      pos="-0.05 0 0.10"
                      rgba="0.3 0.3 0.3 1"
                      contype="0"
                      conaffinity="0"
                      mass="0.03"/>

                <!-- RGB-D 카메라 -->
                <body name="camera_body" pos="-0.05 0 0.2125">
                    <geom name="camera_geom" type="box"
                          size="0.012 0.035 0.010" rgba="0.2 0.2 0.2 1"
                          contype="0" conaffinity="0" mass="0.02"/>
                    <camera name="patrol_camera" pos="0 0 0"
                            fovy="58" quat="0.5 0.5 -0.5 -0.5"/>
                    <site name="camera_site" pos="0 0 0" size="0.003"/>
                </body>

                <!-- IMU 센서 -->
                <site name="imu_site" pos="0 0 0.005" size="0.003"/>
            </body>
        </body>
    </worldbody>

    <!-- ======== 액추에이터 ======== -->
    <actuator>
        <velocity name="motor_left" joint="drive_left"
                  kv="5" forcerange="-1.4 1.4"
                  ctrlrange="-7.58 7.58"/>
        <velocity name="motor_right" joint="drive_right"
                  kv="5" forcerange="-1.4 1.4"
                  ctrlrange="-7.58 7.58"/>
    </actuator>

    <!-- ======== 센서 정의 ======== -->
    <sensor>
        <rangefinder name="lidar" site="lidar_site" cutoff="3.5"/>
        <accelerometer name="imu_accel" site="imu_site"/>
        <gyro name="imu_gyro" site="imu_site"/>
        <jointvel name="encoder_left" joint="drive_left"/>
        <jointvel name="encoder_right" joint="drive_right"/>
        <jointpos name="encoder_pos_left" joint="drive_left"/>
        <jointpos name="encoder_pos_right" joint="drive_right"/>
    </sensor>
</mujoco>