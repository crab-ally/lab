<mujoco model="tron1 handover scene">
  <include file="ur5e.xml"/>

  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <visual>
    <headlight diffuse="0.75 0.75 0.75" ambient="0.25 0.25 0.25" specular="0.2 0.2 0.2"/>
    <global azimuth="135" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture name="floor_texture" type="2d" builtin="checker" width="512" height="512" rgb1="0.18 0.21 0.22" rgb2="0.09 0.11 0.12"/>
    <material name="floor_material" texture="floor_texture" texrepeat="8 8" reflectance="0.15"/>
    <material name="table_material" rgba="0.20 0.24 0.25 1"/>
    <material name="tray_material" rgba="0.12 0.34 0.42 1"/>
    <material name="bottle_material" rgba="0.12 0.55 0.82 0.72" specular="0.8" shininess="0.7"/>
    <material name="cap_material" rgba="0.05 0.08 0.10 1"/>
    <material name="target_material" rgba="0.95 0.55 0.12 0.75"/>
    <material name="finger_material" rgba="0.65 0.68 0.68 1"/>
    <model name="robotiq_2f85_model" file="../robotiq_2f85/2f85.xml"/>
    <model name="tron1_model" file="../../PF_TRON1A/xml/robot.xml"/>
  </asset>

  <worldbody>
    <light name="scene_light" pos="1 -1 2.5" dir="-0.2 0.2 -1" directional="true"/>
    <camera name="handover_camera" pos="1.35 -1.55 1.15" xyaxes="0.75 0.66 0  -0.22 0.25 0.94"/>
    <geom name="floor" type="plane" size="3 3 0.05" material="floor_material"/>
    <body name="handover_table" pos="0.42 0 0.62">
      <geom name="table_top" type="box" size="0.58 0.55 0.04" material="table_material"/>
      <geom name="table_leg_a" type="cylinder" pos="-0.48 -0.45 -0.31" size="0.035 0.31" material="table_material"/>
      <geom name="table_leg_b" type="cylinder" pos="0.48 -0.45 -0.31" size="0.035 0.31" material="table_material"/>
      <geom name="table_leg_c" type="cylinder" pos="-0.48 0.45 -0.31" size="0.035 0.31" material="table_material"/>
      <geom name="table_leg_d" type="cylinder" pos="0.48 0.45 -0.31" size="0.035 0.31" material="table_material"/>
    </body>
    <body name="tron1_carrier" pos="-0.85 0.124 0.82" mocap="true">
      <attach model="tron1_model" body="base_Link" prefix="tron1_"/>
      <geom name="head_mount" type="box" pos="0 0 0.30" size="0.13 0.11 0.025" material="tray_material"/>
    </body>
    <body name="water_bottle" pos="0.452 0.124 1.17" mocap="true">
      <geom name="bottle_body" type="cylinder" size="0.0325 0.110" material="bottle_material" mass="0.5"/>
      <geom name="bottle_cap" type="cylinder" pos="0 0 0.122" size="0.025 0.012" material="cap_material"/>
      <site name="bottle_center" pos="0 0 0" size="0.006" rgba="1 0.25 0.05 1"/>
    </body>
    <geom name="place_target" type="cylinder" pos="0.20 -0.30 0.665" size="0.075 0.003" material="target_material"/>
  </worldbody>
</mujoco>
