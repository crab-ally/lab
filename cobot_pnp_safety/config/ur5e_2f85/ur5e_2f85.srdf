<?xml version="1.0" encoding="UTF-8"?>
<robot name="ur5e_2f85">
  <!-- GROUPS -->
  <group name="ur5e_arm">
    <chain base_link="base" tip_link="pinch-site"/>
  </group>

  <group name="robotiq_2f85">
    <link name="base-mount"/>
    <link name="2f85-base"/>
    <link name="right-driver"/>
    <link name="right-coupler"/>
    <link name="right-spring-link"/>
    <link name="right-follower"/>
    <link name="right-pad"/>
    <link name="right-silicone-pad"/>
    <link name="left-driver"/>
    <link name="left-coupler"/>
    <link name="left-spring-link"/>
    <link name="left-follower"/>
    <link name="left-pad"/>
    <link name="left-silicone-pad"/>
    <link name="pinch-site"/>
    <joint name="right_driver_joint"/>
    <joint name="left_driver_joint"/>
    <joint name="right_spring_link_joint"/>
    <joint name="right_follower_joint"/>
    <joint name="left_spring_link_joint"/>
    <joint name="left_follower_joint"/>
  </group>

  <group name="ur5e_2f85_manipulator">
    <group name="ur5e_arm"/>
    <group name="robotiq_2f85"/>
  </group>

  <!-- GROUP STATES -->
  <group_state name="home" group="ur5e_arm">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-1.5708"/>
    <joint name="elbow_joint" value="1.5708"/>
    <joint name="wrist_1_joint" value="-1.5708"/>
    <joint name="wrist_2_joint" value="-1.5708"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>

  <group_state name="ready" group="ur5e_arm">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-1.5708"/>
    <joint name="elbow_joint" value="1.5708"/>
    <joint name="wrist_1_joint" value="-1.5708"/>
    <joint name="wrist_2_joint" value="-1.5708"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>

  <group_state name="open" group="robotiq_2f85">
    <joint name="right_driver_joint" value="0.0"/>
    <joint name="left_driver_joint" value="0.0"/>
  </group_state>

  <group_state name="close" group="robotiq_2f85">
    <joint name="right_driver_joint" value="0.8"/>
    <joint name="left_driver_joint" value="0.8"/>
  </group_state>

  <!-- END EFFECTOR -->
  <end_effector name="robotiq_2f85" parent_link="pinch-site" group="robotiq_2f85" parent_group="ur5e_arm"/>

  <!-- VIRTUAL JOINT -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base"/>

  <!-- DISABLE COLLISIONS -->
  <disable_collisions link1="base" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="attachment_site" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="base-mount" reason="Adjacent"/>
  <disable_collisions link1="base-mount" link2="2f85-base" reason="Adjacent"/>
  <disable_collisions link1="2f85-base" link2="right-driver" reason="Adjacent"/>
  <disable_collisions link1="2f85-base" link2="left-driver" reason="Adjacent"/>
  <disable_collisions link1="2f85-base" link2="right-spring-link" reason="Adjacent"/>
  <disable_collisions link1="2f85-base" link2="left-spring-link" reason="Adjacent"/>
  <disable_collisions link1="2f85-base" link2="pinch-site" reason="Adjacent"/>
  <disable_collisions link1="right-driver" link2="right-coupler" reason="Adjacent"/>
  <disable_collisions link1="left-driver" link2="left-coupler" reason="Adjacent"/>
  <disable_collisions link1="right-spring-link" link2="right-follower" reason="Adjacent"/>
  <disable_collisions link1="left-spring-link" link2="left-follower" reason="Adjacent"/>
  <disable_collisions link1="right-follower" link2="right-pad" reason="Adjacent"/>
  <disable_collisions link1="left-follower" link2="left-pad" reason="Adjacent"/>
  <disable_collisions link1="right-pad" link2="right-silicone-pad" reason="Adjacent"/>
  <disable_collisions link1="left-pad" link2="left-silicone-pad" reason="Adjacent"/>
</robot>
