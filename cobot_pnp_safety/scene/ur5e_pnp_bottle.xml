<mujoco model="ur5e_scene">
  <compiler angle="radian" meshdir="../assets/ur5e_2f85"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.5 0.5 0.5" specular="0.2 0.2 0.2"/>
  </visual>

  <asset>
    <texture name="ground_texture" type="2d" builtin="checker" rgb1="0.25 0.25 0.25" rgb2="0.12 0.12 0.12" mark="edge" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="ground_texture" texrepeat="5 5" texuniform="true"/>

    <mesh name="bottle_mesh" file="../assets/bottle/bottle.obj"/>
    <material name="bottle_mat" rgba="0.92 0.94 0.96 0.9" specular="0.6" shininess="0.5"/>
    <material name="collision_mat" rgba="0.2 0.8 0.2 0.0"/>
  </asset>

  <default>
    <default class="bottle_collision">
      <geom contype="1" conaffinity="1" condim="4" friction="1.2 0.005 0.0001" material="collision_mat"/>
    </default>
  </default>

  <worldbody>
    <include file="../world/table_bottle.xml"/>
  </worldbody>

  <include file="../model/ur5e_2f85.xml"/>
  <!--<include file="../model/TRON1A.xml"/>-->
</mujoco>